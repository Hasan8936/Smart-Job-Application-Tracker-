# Base URL of the deployed backend API. Include the /api suffix and no trailing slash.
#
# Local development default (used automatically if this is unset): http://localhost:8080/api
#
# On Vercel: set this in Project Settings -> Environment Variables with the key
#   VITE_API_BASE
# pointing at your deployed backend, e.g. a Render service:
#   https://sjt-backend.onrender.com/api
#
# NOTE: Vite only exposes variables prefixed with VITE_ to the browser, and the
# value is baked in at BUILD time, so you must redeploy after changing it.
VITE_API_BASE=http://localhost:8080/api

# Public URL of the deployed AI Support Agent FastAPI service.
# Example local value: http://localhost:8000
# Set this in Vercel before building the production frontend.
VITE_SUPPORT_AGENT_URL=http://localhost:8000

# Optional: only needed when the support API has SUPPORT_API_KEY enabled.
# Never expose a privileged or administrative key here.
VITE_SUPPORT_AGENT_API_KEY=
